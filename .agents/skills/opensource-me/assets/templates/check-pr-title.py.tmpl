#!/usr/bin/env python3
"""Check a Conventional Commit title from an argument or GitHub event JSON."""

import json
import os
import re
import sys


def main():
    if len(sys.argv) > 2:
        print("Usage: check-pr-title.py [TITLE]", file=sys.stderr)
        return 2
    try:
        if len(sys.argv) == 2:
            title = sys.argv[1]
        else:
            with open(os.environ["GITHUB_EVENT_PATH"], encoding="utf-8") as event:
                title = json.load(event)["pull_request"]["title"]
        pattern = r"(?:feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(?:\([^()\r\n]+\))?!?: [^\s\r\n][^\r\n]*"
        if not isinstance(title, str) or re.fullmatch(pattern, title) is None:
            print("Use a Conventional Commit title: type(scope)!: description", file=sys.stderr)
            return 1
    except (OSError, KeyError, TypeError, ValueError):
        print("Cannot read a pull request title from the event.", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
