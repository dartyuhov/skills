name: Feature request
description: Describe a problem and a proposed improvement.
body:
  - type: textarea
    id: problem
    attributes:
      label: Problem
      description: Describe the task you can't complete today.
    validations:
      required: true
  - type: textarea
    id: proposal
    attributes:
      label: Proposed improvement
      description: Include the expected outcome and alternatives considered.
    validations:
      required: true
